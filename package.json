    "test:e2e": "playwright test",
    "layout:generate": "node scripts/generate-spike-layout.mjs",
    "knowledge:ingest": "node scripts/knowledge/ingest-production-pack.mjs",
    "knowledge:validate": "node scripts/knowledge/validate.mjs",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "nuxt": "4.5.2",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@nuxtjs/i18n": "10.6.0",
    "@playwright/test": "1.63.0",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "elkjs": "0.12.0",
    "eslint": "10.11.0",
    "happy-dom": "18.0.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "vue-tsc": "3.3.11"
  },
  "engines": {
    "node": ">=22.19.0 <23",
    "pnpm": ">=9.12.1 <10"
  },
  "packageManager": "pnpm@9.12.1"
