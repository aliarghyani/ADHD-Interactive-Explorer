{
  "name": "adhd-interactive-explorer",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "test": "nuxt prepare && vitest run",
    "test:contract": "nuxt prepare && vitest run tests/contract/knowledge-validation.spec.ts",
